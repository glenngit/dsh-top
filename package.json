{
  "name": "dsh-sysmon",
  "version": "0.1.0",
  "description": "System Monitor for the dsh web GUI: a bashtop-style floating panel (top-right) showing CPU, RAM, disk, network throughput, and the top 6 processes.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "system-monitor",
    "bashtop",
    "web"
  ],
  "license": "MIT"
}
